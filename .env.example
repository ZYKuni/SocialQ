# 复制为 .env.local 后填写。.env.local 已在 .gitignore 里，不会被提交。
# 不填密钥时，App 和实验脚本会自动进入演示模式（mock）。

LLM_API_KEY=sk-你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 可选：实验脚本估算花费用的单价（元 / 百万 token），以 DeepSeek 官网当前价格为准
# deepseek-flash 高峰价约为输入 0.30 美元、输出 1.20 美元 / 百万 token，折合约 2 元、8.5 元
# LLM_PRICE_IN_PER_M=2
# LLM_PRICE_OUT_PER_M=8

# ---------- 小区试点（不填就保持演示模式，和样本人物配对） ----------
# Supabase 控制台 → Project Settings → API。service role key 只放服务端，千万不要发给别人
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# 注册时要输入的小区口令
# COMMUNITY_CODE=
# 登录 cookie 的签名密钥，随便一串 32 位以上的随机字符
# SESSION_SECRET=
# 本地开发不连 Supabase，用 .data/dev-db.json 当数据库（口令为 dev）
# COMMUNITY_DEV_DB=1
