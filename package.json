{
  "name": "socialq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:persona": "node scripts/check-persona.mjs",
    "check:community": "node scripts/check-community.mjs",
    "eval:card": "node --env-file-if-exists=.env.local evals/persona-card/run.mjs",
    "eval:guards": "node evals/persona-card/guards.mjs",
    "eval:followup": "node --env-file-if-exists=.env.local evals/persona-card/followup.mjs",
    "eval:compare": "node --env-file-if-exists=.env.local evals/persona-card/compare.mjs",
    "eval:calibrate": "node evals/persona-card/calibrate.mjs",
    "eval:deid": "node evals/persona-card/deid.mjs",
    "round": "node --env-file-if-exists=.env.local scripts/run-round.mjs",
    "exp:prepare": "node experiments/speed-dating/01_prepare.mjs",
    "exp:baselines": "node experiments/speed-dating/02_baselines.mjs",
    "exp:pilot": "node experiments/speed-dating/03_llm.mjs --limit 20",
    "exp:llm": "node experiments/speed-dating/03_llm.mjs",
    "exp:eval": "node experiments/speed-dating/04_evaluate.mjs",
    "exp:all": "npm run exp:prepare && npm run exp:baselines && npm run exp:llm && npm run exp:eval"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "framer-motion": "12.9.4",
    "next": "15.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=18.18"
  },
  "overrides": {
    "motion-dom": "12.9.4",
    "motion-utils": "12.9.4"
  }
}
